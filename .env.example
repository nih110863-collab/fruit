# Neon Postgres 연결 문자열 (Vercel > Storage > Neon 연결 시 자동 주입됨)
DATABASE_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 관리자(주인) 로그인 비밀번호
ADMIN_PASSWORD="바꿔주세요"

# 쿠키 서명용 비밀키. 아무 긴 랜덤 문자열이면 됩니다.
# 생성: openssl rand -base64 32
SESSION_SECRET="바꿔주세요-랜덤한-긴-문자열"

# 가게 이름 (화면 상단에 표시)
NEXT_PUBLIC_SHOP_NAME="새벽앤과일"

# 아래 세 개는 값이 있을 때만 화면에 나타납니다. 필요 없으면 지워두세요.

# 지점명. "가게이름 / 지점명" 형태로 상단에 표시됩니다.
NEXT_PUBLIC_SHOP_BRANCH="인천논현점"

# 연락처. 상단에 표시되고 눌러서 바로 전화 걸기가 됩니다.
NEXT_PUBLIC_SHOP_PHONE="032-000-0000"

# 카카오톡 오픈채팅방 링크. 상단에 아이콘으로 표시되고 새 탭에서 열립니다.
NEXT_PUBLIC_OPENCHAT_URL="https://open.kakao.com/o/xxxxxxx"

# 아래는 새 주문·주문 수정이 들어올 때 사장님에게 알림을 보내는 채널입니다.
# 둘 다 선택사항이고, 둘 다 설정하면 동시에 옵니다. 비워두면 알림 없이 그냥 동작합니다
# (주문 자체엔 영향 없음). 설정 방법은 README 참고.

# ntfy.sh — 가입·토큰 없이 폰에 푸시로 옵니다. 아무 값이나 정하되, 남이 못 맞히게
# 길고 알아보기 어렵게 지으세요 (예: 가게이름-임의숫자).
NTFY_TOPIC=""

# 텔레그램 — 봇 생성이 필요해 ntfy보다 설정이 조금 더 걸립니다.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
